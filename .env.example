# ============================================================
# Sao chép tệp này thành .env rồi điền thông tin thật
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# ============================================================

# --- Django ---
SECRET_KEY=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Cơ sở dữ liệu ---
# DB_ENGINE=sqlite  -> chạy nhanh không cần cài SQL Server
# DB_ENGINE=mssql   -> dùng SQL Server (yêu cầu ODBC Driver 17/18)
DB_ENGINE=mssql
DB_NAME=PCPartsDB
DB_USER=sa
DB_PASSWORD=MatKhauCuaBan
DB_HOST=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_EXTRA_PARAMS=TrustServerCertificate=yes
# Đặt True nếu dùng Windows Authentication (khi đó bỏ trống DB_USER/DB_PASSWORD)
DB_TRUSTED_CONNECTION=False

# --- Cloudinary (để trống nếu muốn lưu ảnh trong thư mục media/) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Thông tin cửa hàng ---
SHOP_NAME=LinhKienPC
SHOP_HOTLINE=1900 6868
SHOP_EMAIL=hotro@linhkienpc.vn
SHOP_ADDRESS=123 Nguyễn Văn Cừ, Quận 5, TP.HCM

# --- Bảo mật khi triển khai (chỉ có tác dụng khi DEBUG=False) ---
# Đặt False nếu server chưa có chứng chỉ HTTPS, tránh bị chuyển hướng vô hạn
USE_HTTPS=True

# --- Tham số nghiệp vụ ---
DEFAULT_SHIPPING_FEE=30000
FREE_SHIPPING_THRESHOLD=2000000
LOW_STOCK_THRESHOLD=10
EXPIRY_WARNING_DAYS=30
